      }
    },
    "expected_response_attrs": {
      "gen_ai.usage.input_tokens": 17,
      "gen_ai.usage.output_tokens": 12
    }
  },
  {
    "name": "cohere_response_falls_back_to_tokens_when_no_billed_units",
    "provider": "cohere",
    "comment": "When billed_units is absent, fall back to meta.tokens.",
