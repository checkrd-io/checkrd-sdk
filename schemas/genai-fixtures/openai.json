[
  {
    "name": "openai_chat_request",
    "provider": "openai",
    "request": { "body": { "model": "gpt-4o-2024-08-06", "messages": [{ "role": "user", "content": "hi" }], "stream": false } },
    "expected_request_attrs": { "gen_ai.request.model": "gpt-4o-2024-08-06", "gen_ai.request.stream": false }
  },
  {
    "name": "openai_chat_response_with_cache_and_reasoning",
    "provider": "openai",
    "response": {
      "body": {
        "model": "gpt-4o-2024-08-06",
        "usage": {
          "prompt_tokens": 1000,
          "completion_tokens": 500,
          "total_tokens": 1500,
          "prompt_tokens_details": { "cached_tokens": 800 },
          "completion_tokens_details": { "reasoning_tokens": 200 }
        }
      }
    },
    "expected_response_attrs": {
      "gen_ai.response.model": "gpt-4o-2024-08-06",
      "gen_ai.usage.input_tokens": 1000,
      "gen_ai.usage.output_tokens": 500,
      "gen_ai.usage.cache_read.input_tokens": 800,
      "gen_ai.usage.reasoning.output_tokens": 200
    }
  },
  {
    "name": "openai_response_no_details_block",
    "provider": "openai",
    "response": { "body": { "model": "gpt-4o-mini", "usage": { "prompt_tokens": 50, "completion_tokens": 20 } } },
    "expected_response_attrs": {
      "gen_ai.response.model": "gpt-4o-mini",
      "gen_ai.usage.input_tokens": 50,
      "gen_ai.usage.output_tokens": 20
    }
  },
  {
    "name": "openai_response_zero_cached_tokens_omitted",
    "provider": "openai",
    "comment": "cached_tokens of 0 still emits the attribute (0 is a valid count, distinct from absent).",
    "response": { "body": { "model": "gpt-4o", "usage": { "prompt_tokens": 100, "completion_tokens": 40, "prompt_tokens_details": { "cached_tokens": 0 } } } },
    "expected_response_attrs": {
      "gen_ai.response.model": "gpt-4o",
      "gen_ai.usage.input_tokens": 100,
      "gen_ai.usage.output_tokens": 40,
      "gen_ai.usage.cache_read.input_tokens": 0
    }
  },
  {
    "name": "openai_partial_non_integer_usage_skipped",
    "provider": "openai",
    "comment": "Non-integer / wrong-typed usage values are skipped, not coerced; model still extracted.",
    "response": { "body": { "model": "gpt-4o", "usage": { "prompt_tokens": "lots", "completion_tokens": 40, "prompt_tokens_details": { "cached_tokens": 1.5 } } } },
    "expected_response_attrs": {
      "gen_ai.response.model": "gpt-4o",
      "gen_ai.usage.output_tokens": 40
    }
  },
  {
    "name": "openai_malformed_body_yields_empty",
    "provider": "openai",
    "response": { "body": [1, 2, 3] },
    "expected_response_attrs": {}
  }
]
